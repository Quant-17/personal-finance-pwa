{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "ES2023",
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true,
    "types": ["node"]
  },
  "include": [
    "vite.config.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    "tests",
    "supabase/functions/gmail-receipts/handler.ts",
    "supabase/functions/gmail-receipts/receipts.ts",
    "supabase/functions/gmail-receipts/crypto.ts",
    "supabase/functions/gmail-receipts/*.test.ts"
  ]
}
