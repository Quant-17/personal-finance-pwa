# Copy to .env.local for private mode. .env.local is ignored by Git.
VITE_APP_MODE=private
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_with_public_client_key
# VITE_* values enter the browser bundle. Never add secret or service-role keys.
# npm run build:demo explicitly builds the synthetic demo instead.
# Gmail import needs separate SERVER secrets; see GMAIL_IMPORT.md.
# GOOGLE_GMAIL_CLIENT_SECRET / GMAIL_TOKEN_ENCRYPTION_KEY / GMAIL_SCHEDULER_SECRET
# belong in Supabase Edge Function secrets only. Do not add them here or to VITE_*.
