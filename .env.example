# Phase 1 does not read these variables or connect to Supabase.
# Future client configuration: project URL and public publishable/anon key ONLY.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-public-publishable-key
# NEVER place a service-role/secret key in VITE_* variables or client code.
